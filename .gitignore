# the LoRA adapter folder of the trainer: rewritten on every run (the real adapters are in trainer/runs/)
trainer/grpo_trainer_lora_model/
# logs: keep only the training logs of run 2 (trainer/run2.log) and run 3 (trainer/run.log)
trainer/*.log
!trainer/run2.log
!trainer/run.log

